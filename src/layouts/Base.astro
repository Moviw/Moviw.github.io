---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Particles from "../components/Particles.astro";
import avatar from "../../content/avatar.jpg";
import { ui, site, langs, href, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const t = ui[lang];
const me = t.home;
const base = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, "") || "/";
const pageTitle = title ? `${title} · ${site.name}` : site.homeTitle;
const nav = [
  { path: "/", label: t.nav.home },
  { path: "/#experience", label: t.nav.experience },
  { path: "/blog/", label: t.nav.blog },
  { path: "/about/", label: t.nav.about },
];
const isActive = (p: string) => (p === "/" ? base === "/" : base.startsWith(p));
const other: Lang = lang === "en" ? "zh" : "en";
const htmlLang = { en: "en", zh: "zh-CN" }[lang];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, base), Astro.site)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <Particles />
    <header class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-6 sm:px-6">
      <a href={href(lang)} class="font-mono text-sm font-medium tracking-tight">movi<span class="text-[var(--accent)]">.</span></a>
      <nav class="-mr-1.5 flex flex-wrap items-center gap-0.5 text-sm sm:gap-3">
        {
          nav.map((n) => (
            <a
              href={href(lang, n.path)}
              class:list={[
                "rounded-md px-1.5 py-1 transition-colors duration-300 sm:px-2",
                isActive(n.path) ? "text-[var(--fg)]" : "text-[var(--muted)] hover:text-[var(--fg)]",
              ]}
              aria-current={isActive(n.path) ? "page" : undefined}
            >
              {n.label}
            </a>
          ))
        }
        <a
          href={href(other, base)}
          hreflang={other}
          lang={other}
          class="rounded-md px-1.5 py-1 font-mono text-xs text-[var(--muted)] transition-colors duration-300 hover:text-[var(--fg)]"
        >
          {other === "zh" ? "中文" : "EN"}
        </a>
        <button id="theme-toggle" type="button" aria-label={t.theme} class="rounded-md p-1.5 text-[var(--muted)] hover:text-[var(--fg)]">
          <Icon name="ri:sun-line" class="hidden size-4 dark:block" />
          <Icon name="ri:moon-line" class="size-4 dark:hidden" />
        </button>
      </nav>
    </header>

    <!-- Phone: sidebar on top, one column. md and up: sticky sidebar left, content right. -->
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-24 sm:px-6 md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-16 md:pt-16">
      <aside class="reveal flex flex-col items-center text-center md:sticky md:top-12 md:self-start">
        <div class="group relative">
          <div
            class="absolute -inset-1.5 rounded-full bg-[conic-gradient(from_0deg,var(--accent),transparent_40%,var(--accent))] opacity-40 blur-sm transition-opacity duration-700 group-hover:opacity-80 motion-safe:animate-[spin_12s_linear_infinite]"
          >
          </div>
          <Image
            src={avatar}
            alt={me.name}
            width={200}
            height={200}
            densities={[1, 2]}
            loading="eager"
            class="relative size-36 rounded-full border-4 border-[var(--bg)] object-cover transition-transform duration-700 ease-[var(--ease-site)] group-hover:scale-105 md:size-[200px]"
          />
        </div>
        <p class="mt-6 text-2xl font-semibold tracking-tight">{me.name}</p>
        {me.nickname && <p class="mt-1 text-sm text-[var(--muted)]">{me.nickname}</p>}
        <p class="mt-1 text-sm text-[var(--muted)]">{me.role}</p>
        <ul class="mt-5 flex gap-4 text-[var(--muted)]">
          <li>
            <a data-user={site.email.user} data-domain={site.email.domain} href="#" aria-label="Email" title="Email" class="hover:text-[var(--accent)]">
              <Icon name="ri:mail-line" class="size-5" />
            </a>
          </li>
          {
            site.socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name} class="hover:text-[var(--accent)]">
                  <Icon name={s.icon} class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
      <main class="mt-14 min-w-0 md:mt-0">
        <slot />
      </main>
    </div>

    <footer class="mx-auto max-w-6xl px-4 pb-10 text-xs text-[var(--muted)] sm:px-6">
      © {new Date().getFullYear()} {site.name} · {t.footer}
    </footer>

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        document.dispatchEvent(new Event("themechange"));
      });

      // Fade elements in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => {
        // Anything already on screen shows right away; the rest waits for scroll.
        if (el.getBoundingClientRect().top < window.innerHeight) requestAnimationFrame(() => el.classList.add("in"));
        else io.observe(el);
      });

      // Assemble the email address in the browser so it never sits whole in the HTML.
      document.querySelectorAll<HTMLAnchorElement>("a[data-user]").forEach((a) => {
        const addr = `${a.dataset.user}@${a.dataset.domain}`;
        a.href = `mailto:${addr}`;
      });
    </script>
  </body>
</html>
