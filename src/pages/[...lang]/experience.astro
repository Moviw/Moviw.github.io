---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { ui, langPaths, type Lang } from "../../i18n/ui";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].exp;
const groups = [
  { title: t.workTitle, items: t.work },
  { title: t.eduTitle, items: t.edu },
];
---

<Base lang={lang} title={t.title}>
  <h1 class="reveal text-3xl font-semibold tracking-tight">{t.title}</h1>
  {
    groups.map((g, gi) => (
      <Section title={g.title} i={gi}>
        <ol class="space-y-4">
          {g.items.map((e, i) => (
            <li
              class="reveal rounded-xl border border-[var(--line)] bg-[var(--card)] p-5 backdrop-blur transition-[border-color,transform] duration-700 ease-[var(--ease-site)] hover:-translate-y-0.5 hover:border-[var(--accent)]"
              style={`--i:${i}`}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-medium">{e.title}</h3>
                <time class="font-mono text-xs text-[var(--muted)]">{e.when}</time>
              </div>
              <p class="prose-body mt-0.5 text-sm text-[var(--muted)]">
                {e.orgUrl ? <a href={e.orgUrl} target="_blank" rel="noopener">{e.org}</a> : e.org}
                {e.where && <span> · {e.where}</span>}
              </p>
              {e.detail && <p class="prose-body mt-3 text-sm leading-relaxed" set:html={e.detail} />}
            </li>
          ))}
        </ol>
      </Section>
    ))
  }
</Base>
