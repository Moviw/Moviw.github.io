---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { ui, langPaths, type Lang } from "../../i18n/ui";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].about;
---

<Base lang={lang} title={t.title}>
  <h1 class="reveal text-3xl font-semibold tracking-tight">{t.title}</h1>
  <div class="reveal mt-8 space-y-4 leading-relaxed" style="--i:1">
    {t.intro.map((p) => <p>{p}</p>)}
  </div>

  <Section title={t.hobbiesTitle}>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        t.hobbies.map((h, i) => (
          <li class="reveal rounded-xl border border-[var(--line)] bg-[var(--card)] px-4 py-3 text-sm backdrop-blur" style={`--i:${i}`}>
            {h}
          </li>
        ))
      }
    </ul>
  </Section>

</Base>
