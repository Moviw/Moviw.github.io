---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { ui, url, langPaths, type Lang } from "../../i18n/ui";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].home;
const exp = ui[lang].exp;
const groups = [
  { title: exp.workTitle, items: exp.work },
  { title: exp.eduTitle, items: exp.edu },
];
---

<Base lang={lang}>
  <h1 class="sr-only">{t.name}</h1>
  <section class="reveal prose-body space-y-4 leading-relaxed">
    {t.bio.map((p) => <p set:html={p} />)}
  </section>

  {
    t.open && (
      <p
        class="reveal mt-8 inline-flex items-center gap-2.5 rounded-full border border-[var(--line)] bg-[var(--card)] px-4 py-2 text-sm backdrop-blur"
        style="--i:1"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60 motion-safe:animate-ping" />
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
        </span>
        {t.open}
      </p>
    )
  }

  <Section title={t.interestsTitle}>
    <ul class="flex flex-wrap gap-2">
      {
        t.interests.map((x) => (
          <li class="rounded-md border border-[var(--line)] bg-[var(--card)] px-3 py-1 font-mono text-xs backdrop-blur transition-colors duration-300 hover:border-[var(--accent)]">
            {x}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title={t.newsTitle}>
    <ol class="relative space-y-5 border-l border-[var(--line)] pl-6">
      {
        t.news.map((n, i) => (
          <li class="reveal relative" style={`--i:${i}`}>
            <span class="absolute top-2 -left-[1.6rem] size-2 rounded-full border-2 border-[var(--bg)] bg-[var(--accent)]" />
            <time class="font-mono text-xs text-[var(--muted)]">{n.date}</time>
            <p class="prose-body mt-0.5" set:html={n.text} />
          </li>
        ))
      }
    </ol>
  </Section>

  <div id="experience" class="scroll-mt-8">
    {
      groups.map((g) => (
        <Section title={g.title}>
          <ol class="space-y-4">
            {g.items.map((e, i) => (
              <li
                class="reveal rounded-xl border border-[var(--line)] bg-[var(--card)] p-5 backdrop-blur transition-[border-color,transform] duration-700 ease-[var(--ease-site)] hover:-translate-y-0.5 hover:border-[var(--accent)]"
                style={`--i:${i}`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="font-medium">{e.title}</h3>
                  <time class="font-mono text-xs text-[var(--muted)]">{e.when}</time>
                </div>
                <p class="prose-body mt-0.5 text-sm text-[var(--muted)]">
                  {e.orgUrl ? <a href={url(e.orgUrl)} target="_blank" rel="noopener">{e.org}</a> : e.org}
                  {e.where && <span> · {e.where}</span>}
                </p>
                {e.detail && <p class="prose-body mt-3 text-sm leading-relaxed" set:html={e.detail} />}
              </li>
            ))}
          </ol>
        </Section>
      ))
    }
  </div>
</Base>
